# ============================================================================
# blogitem — 환경 변수 템플릿
# ============================================================================
# 복사: cp .env.example .env
# 실제 시크릿(API 키, OAuth client_secret)은 keyring 에 저장되며 .env 에 두지 않습니다.
# .env 는 비-시크릿 운영 옵션만.
# ----------------------------------------------------------------------------

# 로그
BLOGITEM_LOG_LEVEL=info              # debug | info | warn | error
BLOGITEM_LOG_DIR=./logs

# 데이터베이스
BLOGITEM_DB_PATH=./data/blogitem.db

# 산출물 저장 디렉토리 (이미지·텍스트)
BLOGITEM_ARTIFACTS_DIR=./data/artifacts

# OAuth 콜백 (네이버 개발자센터에 등록한 값과 일치 필수)
BLOGITEM_OAUTH_CALLBACK_HOST=127.0.0.1
BLOGITEM_OAUTH_CALLBACK_PORT=8765

# 운영 모드
BLOGITEM_DRY_RUN=true                # true → 네이버 실제 게시 차단

# 모델 (anthropic SDK)
BLOGITEM_CLAUDE_MODEL_PRIMARY=claude-opus-4-7
BLOGITEM_CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# LLM 모드 — api / claude_cli / codex_cli
# api        : anthropic SDK (API 키 종량제)
# claude_cli : `claude` CLI subprocess — Claude Max 구독 한도 안에서 $0
# codex_cli  : `codex` CLI subprocess — ChatGPT Plus 구독 한도 안에서 $0
BLOGITEM_LLM_MODE=api
BLOGITEM_LLM_CLI_MODEL=
BLOGITEM_LLM_CLI_TIMEOUT_SEC=600

# (옵션) 메일 발행 폴백 — 네이버 블로그 글쓰기 API 미사용 시
# 비밀번호는 keyring 의 ``smtp_password`` 키에 저장됨 — 여기엔 두지 않음
BLOGITEM_SMTP_HOST=
BLOGITEM_SMTP_PORT=587
BLOGITEM_SMTP_USE_TLS=true
BLOGITEM_SMTP_FROM=
BLOGITEM_NAVER_PUBLISH_EMAIL=
