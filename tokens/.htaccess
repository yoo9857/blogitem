# ============================================================================
# tokens/ — refresh_token / access_token 평문 보관
# ============================================================================
# 노출 시 = 블로그 계정 탈취 동급. 외부 HTTP 직접 접근 절대 차단.
# 운영 시 추가로 chmod 700 (디렉토리), chmod 600 (파일) 권장.
# ----------------------------------------------------------------------------

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
