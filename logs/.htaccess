# ============================================================================
# logs/ — 런타임 NDJSON 로그 (디버그/운영 정보)
# ============================================================================
# 일반적으로 비밀은 포함되지 않지만, 진단용 응답 본문이 들어갈 수 있어 차단.
# ----------------------------------------------------------------------------

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
